<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>RevitModelMcp.Core.Tests</AssemblyName>
    <RootNamespace>RevitModelMcp.Core.Tests</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RollForward>LatestMajor</RollForward>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="TUnit" Version="1.72.16" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\RevitModelMcp.Core\RevitModelMcp.Core.csproj" />
    <Compile Include="..\..\src\RevitModelMcp.BatchSupervisor\BatchRunStore.cs" Link="BatchRunStore.cs" />
    <Compile Include="..\..\src\RevitModelMcp.BatchSupervisor\FileChannelWorkerClient.cs" Link="FileChannelWorkerClient.cs" />
    <Compile Include="..\..\build\install\Installer.Scripts.cs" Link="Installer.Scripts.cs" />
  </ItemGroup>

  <ItemGroup Condition="'$(Channel)' == 'store'">
    <Compile Include="../../src/RevitModelMcp.Core/Updates/UpdatePolicy.cs" Link="UpdatePolicy.cs"/>
  </ItemGroup>
</Project>
