<Project Sdk="Nice3point.Revit.Sdk/6.3.2">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EnableTUnitPolyfills>false</EnableTUnitPolyfills>
    <RestorePackagesWithLockFile>false</RestorePackagesWithLockFile>
    <IsTestProject Condition="'$(RunRevitTests)' != 'true'">false</IsTestProject>
    <Configurations>Debug.R22;Debug.R23;Debug.R24;Debug.R25;Debug.R26;Debug.R27;Release.R22;Release.R23;Release.R24;Release.R25;Release.R26;Release.R27</Configurations>
  </PropertyGroup>

  <PropertyGroup Condition="'$(RevitVersion)' == '2027'">
    <RevitTestVersion>2027.0.7</RevitTestVersion>
  </PropertyGroup>
  <PropertyGroup Condition="'$(RevitVersion)' != '2027'">
    <RevitTestVersion>$(RevitVersion).1.7</RevitTestVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Nice3point.Revit.Api.RevitAPI" Version="2027.0.0" Condition="'$(RevitVersion)' == '2027'" />
    <PackageReference Include="Nice3point.Revit.Api.RevitAPI" Version="2022.1.1" Condition="'$(RevitVersion)' == '2022'" />
    <PackageReference Include="Nice3point.Revit.Api.RevitAPI" Version="$(RevitVersion).0.*" Condition="'$(RevitVersion)' != '2022' And '$(RevitVersion)' != '2027'" />
    <PackageReference Include="Nice3point.Revit.Api.RevitAPIUI" Version="2027.0.0" Condition="'$(RevitVersion)' == '2027'" />
    <PackageReference Include="Nice3point.Revit.Api.RevitAPIUI" Version="2022.1.1" Condition="'$(RevitVersion)' == '2022'" />
    <PackageReference Include="Nice3point.Revit.Api.RevitAPIUI" Version="$(RevitVersion).0.*" Condition="'$(RevitVersion)' != '2022' And '$(RevitVersion)' != '2027'" />
    <PackageReference Include="Nice3point.TUnit.Revit" Version="$(RevitTestVersion)" />
    <PackageReference Include="TUnit" Version="1.73.19" />
    <PackageReference Include="Polyfill" Version="11.4.5" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/RevitModelMcp.Addin/RevitModelMcp.Addin.csproj"
                      AdditionalProperties="DeployAddin=false;PublishAddin=false;IsRepackable=false;LaunchRevit=false" />
  </ItemGroup>

</Project>
