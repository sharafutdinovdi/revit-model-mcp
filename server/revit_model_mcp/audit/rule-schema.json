{
  "type": "object",
  "properties": {
    "schema": {
      "const": 1,
      "type": "integer"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "extends": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "references": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "severity": {
            "enum": [
              "critical",
              "major",
              "minor",
              "info"
            ]
          },
          "scope": {
            "type": "object",
            "properties": {
              "categories": {
                "type": "array",
                "items": {
                  "oneOf": [
                    {
                      "type": "object",
                      "properties": {
                        "builtin": {
                          "type": "string",
                          "minLength": 1
                        }
                      },
                      "required": [
                        "builtin"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "guid": {
                          "type": "string",
                          "format": "uuid"
                        }
                      },
                      "required": [
                        "guid"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "names": {
                          "type": "array",
                          "items": {
                            "type": "string",
                            "minLength": 1
                          },
                          "minItems": 1
                        }
                      },
                      "required": [
                        "names"
                      ],
                      "additionalProperties": false
                    }
                  ]
                },
                "minItems": 1,
                "maxItems": 20
              },
              "include_templates": {
                "type": "boolean"
              },
              "level": {
                "type": "string",
                "minLength": 1
              },
              "workset": {
                "type": "string",
                "minLength": 1
              },
              "view": {
                "type": "string",
                "minLength": 1
              },
              "phase": {
                "type": "string",
                "minLength": 1
              },
              "family": {
                "type": "string",
                "minLength": 1
              },
              "type_name": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [],
            "additionalProperties": false
          },
          "check": {
            "type": "object",
            "properties": {
              "type": {
                "enum": [
                  "parameter_filled",
                  "parameter_in",
                  "parameter_matches",
                  "name_matches",
                  "count",
                  "model_health",
                  "coordinates",
                  "sheets",
                  "worksets"
                ]
              },
              "parameter": {
                "oneOf": [
                  {
                    "type": "object",
                    "properties": {
                      "builtin": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "required": [
                      "builtin"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "guid": {
                        "type": "string",
                        "format": "uuid"
                      }
                    },
                    "required": [
                      "guid"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "names": {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "minLength": 1
                        },
                        "minItems": 1
                      }
                    },
                    "required": [
                      "names"
                    ],
                    "additionalProperties": false
                  }
                ]
              },
