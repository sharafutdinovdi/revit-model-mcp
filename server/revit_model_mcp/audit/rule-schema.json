        "required": [
          "id"
        ],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "check": {
                  "properties": {
                    "type": {
                      "const": "parameter_filled"
                    }
                  }
                }
              },
              "required": [
                "check"
              ]
            },
            "then": {
              "properties": {
                "threshold": {
                  "required": [
                    "min_percent"
                  ]
                }
              }
            }
          }
        ]
      },
      "maxItems": 200
    }
