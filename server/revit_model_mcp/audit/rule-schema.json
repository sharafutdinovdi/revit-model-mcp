              },
              "clause": {
                "type": "string",
                "minLength": 1
              },
              "text": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [],
            "additionalProperties": false
          },
          "recommendation": {
            "type": "string"
          },
          "enabled": {
            "type": "boolean"
          }
