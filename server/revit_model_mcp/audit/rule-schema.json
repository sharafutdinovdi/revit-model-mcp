                "minItems": 1
              },
              "field": {
                "enum": [
                  "name",
                  "number"
                ]
              }
            },
            "required": [
              "type"
            ],
            "additionalProperties": false,
            "allOf": [
              {
                "if": {
                  "properties": {
                    "type": {
                      "enum": [
                        "parameter_filled",
                        "parameter_in",
                        "parameter_matches"
                      ]
                    }
                  }
                },
                "then": {
                  "required": [
                    "parameter"
                  ]
                }
              },
              {
                "if": {
                  "properties": {
                    "type": {
                      "enum": [
                        "parameter_matches",
                        "name_matches"
                      ]
                    }
                  }
                },
                "then": {
                  "required": [
                    "pattern"
                  ]
                }
              },
              {
                "if": {
                  "properties": {
                    "type": {
                      "enum": [
                        "parameter_in"
                      ]
                    }
                  }
                },
                "then": {
                  "required": [
                    "values"
                  ]
                }
              },
              {
                "if": {
                  "properties": {
                    "type": {
                      "enum": [
                        "model_health",
                        "coordinates",
                        "sheets",
                        "worksets"
                      ]
                    }
                  }
                },
                "then": {
                  "required": [
                    "metric"
                  ]
                }
              },
              {
                "if": {
                  "properties": {
                    "type": {
                      "const": "sheets"
                    },
                    "metric": {
                      "const": "name_matches"
                    }
                  },
                  "required": [
                    "metric"
                  ]
                },
                "then": {
                  "required": [
                    "pattern"
                  ]
                }
              }
            ]
          },
          "threshold": {
            "type": "object",
            "properties": {
              "max_count": {
                "type": "number",
