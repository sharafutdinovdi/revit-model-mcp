<Window x:Class="RevitModelMcp.About.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About Model MCP" SizeToContent="WidthAndHeight" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" PreviewKeyDown="OnPreviewKeyDown">
    <StackPanel Margin="24" MinWidth="320">
        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
            <Image Source="/RevitModelMcp;component/Resources/Icons/Logo32.png" Width="32" Height="32" Margin="0,0,12,0" />
            <TextBlock Text="Model MCP" FontSize="24" FontWeight="SemiBold" VerticalAlignment="Center" />
        </StackPanel>
        <TextBlock x:Name="VersionText" Margin="0,0,0,8" />
        <TextBlock x:Name="RevitText" Margin="0,0,0,8" />
        <TextBlock x:Name="ChannelText" Margin="0,0,0,16" />
        <TextBlock Margin="0,0,0,8"><Hyperlink x:Name="DocumentationLink" RequestNavigate="OnRequestNavigate">Documentation</Hyperlink></TextBlock>
        <TextBlock Margin="0,0,0,8"><Hyperlink x:Name="SourceLink" RequestNavigate="OnRequestNavigate">Source</Hyperlink></TextBlock>
        <TextBlock Margin="0,0,0,8"><Hyperlink x:Name="PrivacyLink" RequestNavigate="OnRequestNavigate">Privacy</Hyperlink></TextBlock>
        <TextBlock Margin="0,0,0,16"><Hyperlink x:Name="SupportLink" RequestNavigate="OnRequestNavigate">Support developer</Hyperlink></TextBlock>
        <Button Content="Close" IsCancel="True" HorizontalAlignment="Right" MinWidth="80" Padding="12,4" />
    </StackPanel>
</Window>
