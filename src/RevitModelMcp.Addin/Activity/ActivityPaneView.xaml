<UserControl x:Class="RevitModelMcp.Activity.ActivityPaneView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:RevitModelMcp.Activity"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="340">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
        <local:CountToVisibilityConverter x:Key="CountToVisibility"/>

        <Style x:Key="LinkButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="0,0,10,0"/>
            <Setter Property="FontSize" Value="10"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="ReadOnlyBadge" Grid.Row="0" Text="Read-only" FontWeight="Bold"
                   Foreground="White" Background="#B00020" Padding="6,2" Margin="0,0,0,8"
                   HorizontalAlignment="Left" Visibility="Collapsed"/>

        <Expander Grid.Row="1" Header="Queue" Margin="0,0,0,8" IsExpanded="True"
                  Visibility="{Binding QueueRows.Count, Converter={StaticResource CountToVisibility}}">
            <ItemsControl ItemsSource="{Binding QueueRows}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" FontSize="11" TextTrimming="CharacterEllipsis">
                                <Run Text="{Binding ClientBadge, Mode=OneWay}" FontWeight="SemiBold"/>
                                <Run Text=" · "/>
                                <Run Text="{Binding Command, Mode=OneWay}" FontFamily="Consolas"/>
                                <Run Text=" · "/>
                                <Run Text="{Binding PositionText, Mode=OneWay}" Foreground="Gray"/>
                            </TextBlock>
                            <Button Grid.Column="1" Content="Cancel" Style="{StaticResource LinkButton}"
                                    Visibility="{Binding CanCancel, Converter={StaticResource BoolToVisibility}}"
                                    Click="OnCancelClick"/>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Expander>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Rows}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="#22808080" BorderThickness="0,0,0,1" Padding="0,6">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding StatusGlyph}" Margin="0,0,5,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#2E7D32"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsFailed}" Value="True">
                                                        <Setter Property="Foreground" Value="#C62828"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Grid.Column="1" Text="{Binding TimeText}" FontFamily="Consolas"
                                               FontSize="10" Foreground="Gray" Margin="0,0,6,0"/>
                                    <TextBlock Grid.Column="2" Text="{Binding ClientBadge}" FontWeight="SemiBold"
                                               FontSize="11" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Grid.Column="3" Text="{Binding StatusText}" FontSize="10" Foreground="Gray"/>
                                </Grid>
                                <TextBlock Text="{Binding Command}" FontFamily="Consolas" FontSize="10" Foreground="#7F808080"/>
                                <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" FontSize="12" Margin="0,2,0,0"/>
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <Button Content="Show all" Style="{StaticResource LinkButton}"
                                            Visibility="{Binding CanShowAll, Converter={StaticResource BoolToVisibility}}"
                                            Click="OnShowAllClick"/>
                                    <Button Content="Undo" Style="{StaticResource LinkButton}"
                                            Visibility="{Binding CanUndo, Converter={StaticResource BoolToVisibility}}"
                                            Click="OnUndoClick"/>
                                </StackPanel>
                                <Expander Header="Details" FontSize="10" Margin="0,2,0,0"
                                          Visibility="{Binding HasElements, Converter={StaticResource BoolToVisibility}}">
                                    <StackPanel Margin="14,2,0,0">
                                        <ItemsControl ItemsSource="{Binding ChangedRefs}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Content="{Binding Label}" Style="{StaticResource LinkButton}"
                                                            HorizontalContentAlignment="Left"
                                                            FontFamily="Consolas" Click="OnElementClick"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <ItemsControl ItemsSource="{Binding CreatedRefs}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Content="{Binding Label}" Style="{StaticResource LinkButton}"
                                                            HorizontalContentAlignment="Left"
                                                            FontFamily="Consolas" Click="OnElementClick"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <ItemsControl ItemsSource="{Binding DeletedRefs}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Label}" FontFamily="Consolas"
                                                               FontSize="10" Foreground="Gray" Margin="0,0,0,2"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Expander>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
