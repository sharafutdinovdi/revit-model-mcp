<UserControl x:Class="RevitModelMcp.Activity.ActivityPaneView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:RevitModelMcp.Activity"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="11.5"
             TextOptions.TextFormattingMode="Display"
             Background="{DynamicResource SurfaceBrush}"
             Foreground="{DynamicResource TextPrimaryBrush}"
             d:DesignHeight="600" d:DesignWidth="340">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ActivityTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
            <local:CountToVisibilityConverter x:Key="CountToVisibility"/>
            <local:ZeroCountToVisibilityConverter x:Key="ZeroCountToVisibility"/>
            <local:InverseBooleanConverter x:Key="InverseBoolean"/>
            <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas</FontFamily>

            <!-- Borderless icon button that shows SurfaceRaised-on-hover feedback only through its glyph colour. -->
            <Style x:Key="IconButton" TargetType="Button">
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Focusable" Value="False"/>
                <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border Background="Transparent" Width="22" Height="20">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Foreground" Value="{DynamicResource RunningBrush}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="LinkText" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource RunningBrush}"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="TextDecorations" Value="Underline"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="Tag" TargetType="Border">
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="7"/>
                <Setter Property="Padding" Value="5,0"/>
                <Setter Property="Margin" Value="6,0,0,0"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="BorderBrush" Value="{DynamicResource TextMutedBrush}"/>
                <Setter Property="TextElement.Foreground" Value="{DynamicResource TextMutedBrush}"/>
                <Setter Property="TextElement.FontSize" Value="10.5"/>
            </Style>

            <!-- Rail node: filled Done by default; filled Failed; hollow for dry run; hollow muted when undone. -->
            <Style x:Key="RailNode" TargetType="Ellipse">
                <Setter Property="Width" Value="8"/>
                <Setter Property="Height" Value="8"/>
                <Setter Property="StrokeThickness" Value="1.5"/>
                <Setter Property="Fill" Value="{DynamicResource DoneBrush}"/>
                <Setter Property="Stroke" Value="{DynamicResource DoneBrush}"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsDryRun}" Value="True">
                        <Setter Property="Fill" Value="Transparent"/>
                        <Setter Property="Stroke" Value="{DynamicResource RunningBrush}"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsFailed}" Value="True">
                        <Setter Property="Fill" Value="{DynamicResource FailedBrush}"/>
                        <Setter Property="Stroke" Value="{DynamicResource FailedBrush}"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsUndone}" Value="True">
                        <Setter Property="Fill" Value="Transparent"/>
                        <Setter Property="Stroke" Value="{DynamicResource TextMutedBrush}"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <!-- Row container: no selection chrome; SurfaceRaised while hovered, keyboard-selected or expanded. -->
            <Style x:Key="RowContainer" TargetType="ListBoxItem">
                <EventSetter Event="Loaded" Handler="OnRowContainerLoaded"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <Border x:Name="Chrome" Background="Transparent">
                                <ContentPresenter/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource SurfaceRaisedBrush}"/>
                                </Trigger>
                                <MultiTrigger>
                                    <MultiTrigger.Conditions>
                                        <Condition Property="IsSelected" Value="True"/>
                                        <Condition Property="IsKeyboardFocusWithin" Value="True"/>
                                    </MultiTrigger.Conditions>
                                    <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource SurfaceRaisedBrush}"/>
                                </MultiTrigger>
                                <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                    <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource SurfaceRaisedBrush}"/>
                                </DataTrigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <DataTemplate x:Key="ElementRowTemplate" DataType="{x:Type local:ActivityElementRefView}">
                <Grid x:Name="ElementRow" Background="Transparent" Margin="0,1" MouseLeftButtonUp="OnElementClick">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="ElementLabel" Text="{Binding Label}" TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding Label}"/>
                    <TextBlock Grid.Column="1" Text="{Binding IdText}" FontFamily="{StaticResource MonoFont}" FontSize="11"
                               Foreground="{DynamicResource TextMutedBrush}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                </Grid>
                <DataTemplate.Triggers>
                    <MultiDataTrigger>
                        <MultiDataTrigger.Conditions>
                            <Condition Binding="{Binding IsSelectable}" Value="True"/>
                            <Condition Binding="{Binding IsMouseOver, ElementName=ElementRow}" Value="True"/>
                        </MultiDataTrigger.Conditions>
                        <Setter TargetName="ElementLabel" Property="TextDecorations" Value="Underline"/>
                        <Setter TargetName="ElementRow" Property="Cursor" Value="Hand"/>
                    </MultiDataTrigger>
                    <DataTrigger Binding="{Binding IsSelectable}" Value="False">
                        <Setter TargetName="ElementLabel" Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
                    </DataTrigger>
                </DataTemplate.Triggers>
            </DataTemplate>

            <DataTemplate x:Key="SectionTemplate" DataType="{x:Type local:ElementSection}">
                <StackPanel Margin="0,2,0,6">
                    <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,3">
                        <Run Text="{Binding Header, Mode=OneWay}"/>
                        <Run Text="{Binding Count, Mode=OneWay}"/>
                    </TextBlock>
                    <ItemsControl ItemsSource="{Binding Items}" ItemTemplate="{StaticResource ElementRowTemplate}"/>
                    <TextBlock Text="{Binding MoreText}" Style="{StaticResource LinkText}" Margin="0,2,0,0"
                               HorizontalAlignment="Left" MouseLeftButtonUp="OnMoreClick"
                               Visibility="{Binding HasMore, Converter={StaticResource BoolToVisibility}}"/>
                </StackPanel>
            </DataTemplate>

            <DataTemplate x:Key="RowTemplate" DataType="{x:Type local:ActivityRowView}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3"/>
                        <ColumnDefinition Width="22"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Rectangle Grid.Column="0" Fill="{Binding LaneBrush}"/>
                    <Rectangle Grid.Column="1" Width="1" Height="11" VerticalAlignment="Top"
                               Fill="{DynamicResource HairlineBrush}"/>
                    <Ellipse Grid.Column="1" VerticalAlignment="Top" Margin="0,12,0,0" Style="{StaticResource RailNode}"/>
                    <Rectangle Grid.Column="1" Width="1" Margin="0,21,0,0" Fill="{DynamicResource HairlineBrush}"/>

                    <StackPanel Grid.Column="2" Margin="0,7,8,7">
                        <Grid Background="Transparent" MouseLeftButtonUp="OnRowHeaderClick">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock x:Name="Title" Text="{Binding Title}" FontSize="13" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}" VerticalAlignment="Center"/>

                            <StackPanel x:Name="Actions" Grid.Column="1" Orientation="Horizontal" Margin="4,0,0,0"
                                        Visibility="Collapsed">
                                <Button Style="{StaticResource IconButton}" ToolTip="{x:Static local:PaneText.Show}"
                                        Click="OnShowClick"
                                        Visibility="{Binding CanShowAll, Converter={StaticResource BoolToVisibility}}">
                                    <Path Data="M1,6.5 A5.5,5.5 0 1 0 12,6.5 A5.5,5.5 0 1 0 1,6.5 M10.4,10.4 L14,14"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          Width="15" Height="15" Stretch="Uniform"/>
                                </Button>
                                <Button Style="{StaticResource IconButton}" ToolTip="{x:Static local:PaneText.Undo}"
                                        Click="OnUndoClick"
                                        Visibility="{Binding CanUndo, Converter={StaticResource BoolToVisibility}}">
                                    <Path Data="M4.5,1.5 L1.5,4.5 L4.5,7.5 M1.5,4.5 H9.5 A4,4 0 0 1 9.5,12.5 H5.5"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round" Width="14" Height="14" Stretch="Uniform"/>
                                </Button>
                            </StackPanel>

                            <TextBlock Grid.Column="2" Text="{Binding TimeText}" ToolTip="{Binding TimeToolTip}"
                                       Foreground="{DynamicResource TextMutedBrush}" Margin="8,0,0,0" VerticalAlignment="Center"/>

                            <Button Grid.Column="3" Style="{StaticResource IconButton}" Click="OnChevronClick"
                                    Visibility="{Binding HasElements, Converter={StaticResource BoolToVisibility}}">
                                <Path x:Name="ChevronPath" Data="M0,0 L4,4 L8,0" Width="8" Height="5" StrokeThickness="1.4"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" RenderTransformOrigin="0.5,0.5"/>
                            </Button>

                            <DockPanel Grid.Row="1" Grid.ColumnSpan="4" Margin="0,2,0,0" LastChildFill="True">
                                <TextBlock DockPanel.Dock="Left" Text="{Binding ClientName}" Foreground="{Binding LaneBrush}"/>
                                <TextBlock DockPanel.Dock="Left" Text=" · " Foreground="{DynamicResource TextMutedBrush}"/>

                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <Border Style="{StaticResource Tag}"
                                            Visibility="{Binding IsDryRun, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock Text="{x:Static local:PaneText.DryRunTag}"/>
                                    </Border>
                                    <Border Style="{StaticResource Tag}"
                                            Visibility="{Binding IsUndone, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock Text="{x:Static local:PaneText.UndoneTag}"/>
                                    </Border>
                                    <Border Style="{StaticResource Tag}" BorderBrush="{DynamicResource FailedBrush}"
                                            TextElement.Foreground="{DynamicResource FailedBrush}"
                                            Visibility="{Binding IsFailed, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock Text="{x:Static local:PaneText.FailedTag}"/>
                                    </Border>
                                </StackPanel>

                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="6,0,0,0">
                                    <TextBlock Text="{Binding ChangedChip}" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,5,0"
                                               Visibility="{Binding ChangedCount, Converter={StaticResource CountToVisibility}}"/>
                                    <TextBlock Text="{Binding CreatedChip}" Foreground="{DynamicResource CreatedBrush}" Margin="0,0,5,0"
                                               Visibility="{Binding CreatedCount, Converter={StaticResource CountToVisibility}}"/>
                                    <TextBlock Text="{Binding DeletedChip}" Foreground="{DynamicResource DeletedBrush}" Margin="0,0,5,0"
                                               Visibility="{Binding DeletedCount, Converter={StaticResource CountToVisibility}}"/>
                                </StackPanel>

                                <Grid>
                                    <TextBlock x:Name="Document" Text="{Binding DocumentTitle}" TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource TextMutedBrush}" ToolTip="{Binding DocumentTitle}"/>
                                    <TextBlock x:Name="Error" Text="{Binding ErrorText}" TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource FailedBrush}" ToolTip="{Binding ErrorText}"
                                               Visibility="Collapsed"/>
                                </Grid>
                            </DockPanel>
                        </Grid>

                        <StackPanel x:Name="Details" Margin="0,8,0,0" ClipToBounds="True"
                                    Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVisibility}}">
                            <ItemsControl ItemsSource="{Binding Sections}" ItemTemplate="{StaticResource SectionTemplate}"
                                          Focusable="False"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
                <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                        <Setter TargetName="Actions" Property="Visibility" Value="Visible"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                        <Setter TargetName="Actions" Property="Visibility" Value="Visible"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                        <Setter TargetName="ChevronPath" Property="RenderTransform">
                            <Setter.Value>
                                <RotateTransform Angle="180"/>
                            </Setter.Value>
                        </Setter>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsUndone}" Value="True">
                        <Setter TargetName="Title" Property="TextDecorations" Value="Strikethrough"/>
                        <Setter TargetName="Title" Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsFailed}" Value="True">
                        <Setter TargetName="Document" Property="Visibility" Value="Collapsed"/>
                        <Setter TargetName="Error" Property="Visibility" Value="Visible"/>
                    </DataTrigger>
                </DataTemplate.Triggers>
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Height="28" BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="0,0,0,1"
                Visibility="{Binding State.IsReadOnly, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="{x:Static local:PaneText.ReadOnly}" Foreground="{DynamicResource ReadOnlyBrush}"
                       FontWeight="SemiBold" Margin="12,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
        </Border>

        <Border Grid.Row="1" BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="0,0,0,1"
                Background="{DynamicResource SurfaceRaisedBrush}"
                Visibility="{Binding State.HasLive, Converter={StaticResource BoolToVisibility}}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="2"/>
                </Grid.RowDefinitions>
                <Rectangle Grid.RowSpan="2" Width="3" HorizontalAlignment="Left" Fill="{Binding State.LiveLane}"/>
                <Grid Margin="12,8,6,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Ellipse x:Name="LiveNode" Width="8" Height="8" StrokeThickness="1.5" VerticalAlignment="Center"
                             Stroke="{DynamicResource RunningBrush}">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="Transparent"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding State.IsRunning}" Value="True">
                                        <Setter Property="Fill" Value="{DynamicResource RunningBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Grid.Column="1" Margin="8,0,8,0" VerticalAlignment="Center">
                        <Run Text="{x:Static local:PaneText.Now}" Foreground="{DynamicResource TextMutedBrush}"/>
                        <Run Text="·" Foreground="{DynamicResource TextMutedBrush}"/>
                        <Run Text="{Binding State.LiveClient, Mode=OneWay}" Foreground="{Binding State.LiveLane, Mode=OneWay}"/>
                    </TextBlock>
                    <TextBlock Grid.Column="2" Text="{Binding State.LiveTitle}" FontSize="13" FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip="{Binding State.LiveTitle}"/>
                    <ToggleButton x:Name="QueueToggle" Grid.Column="3" Margin="6,0,0,0" Cursor="Hand" Focusable="False"
                                  IsHitTestVisible="{Binding IsOpen, ElementName=QueuePopup, Converter={StaticResource InverseBoolean}}">
                        <ToggleButton.Template>
                            <ControlTemplate TargetType="ToggleButton">
                                <Border x:Name="Pill" CornerRadius="8" Padding="7,1" BorderThickness="1"
                                        BorderBrush="{DynamicResource HairlineBrush}" Background="Transparent">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding State.ActiveCount}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        <Path Data="M0,0 L4,4 L8,0" Width="8" Height="5" Margin="5,1,0,0" StrokeThickness="1.4"
                                              Stroke="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Pill" Property="BorderBrush" Value="{DynamicResource RunningBrush}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </ToggleButton.Template>
                    </ToggleButton>
                    <Popup x:Name="QueuePopup" PlacementTarget="{Binding ElementName=QueueToggle}" Placement="Bottom"
                           StaysOpen="False" AllowsTransparency="True" PopupAnimation="None"
                           IsOpen="{Binding IsChecked, ElementName=QueueToggle, Mode=TwoWay}">
                        <Border Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="{DynamicResource HairlineBrush}"
                                BorderThickness="1" CornerRadius="4" Padding="0,4" MinWidth="240" MaxWidth="420"
                                TextElement.Foreground="{DynamicResource TextPrimaryBrush}"
                                TextElement.FontSize="11.5">
                            <ItemsControl ItemsSource="{Binding QueueRows}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type local:QueueRowView}">
                                        <Grid Margin="0,3,10,3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="3"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Rectangle Fill="{Binding LaneBrush}"/>
                                            <TextBlock Grid.Column="1" Margin="8,0,8,0" TextTrimming="CharacterEllipsis">
                                                <Run Text="{Binding ClientName, Mode=OneWay}" Foreground="{Binding LaneBrush, Mode=OneWay}"/>
                                                <Run Text="·" Foreground="{DynamicResource TextMutedBrush}"/>
                                                <Run Text="{Binding Command, Mode=OneWay}" FontFamily="{StaticResource MonoFont}" FontSize="11"/>
                                                <Run Text="·" Foreground="{DynamicResource TextMutedBrush}"/>
                                                <Run Text="{Binding PositionText, Mode=OneWay}" Foreground="{DynamicResource TextMutedBrush}"/>
                                            </TextBlock>
                                            <TextBlock Grid.Column="2" Text="{x:Static local:PaneText.Cancel}" Style="{StaticResource LinkText}"
                                                       MouseLeftButtonUp="OnCancelClick"
                                                       Visibility="{Binding CanCancel, Converter={StaticResource BoolToVisibility}}"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>
                    </Popup>
                </Grid>
                <Rectangle x:Name="Sweep" Grid.Row="1" Height="2"
                           Visibility="{Binding State.IsRunning, Converter={StaticResource BoolToVisibility}}"/>
            </Grid>
        </Border>

        <StackPanel Grid.Row="2" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24"
                    Visibility="{Binding Rows.Count, Converter={StaticResource ZeroCountToVisibility}}">
            <TextBlock Text="{x:Static local:PaneText.EmptyTitle}" FontSize="13" TextWrapping="Wrap" TextAlignment="Center"
                       Foreground="{DynamicResource TextMutedBrush}"/>
            <TextBlock Text="{x:Static local:PaneText.EmptyHint}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,6,0,0"
                       Foreground="{DynamicResource TextMutedBrush}" Opacity="0.8"/>
        </StackPanel>

        <ListBox x:Name="RowList" Grid.Row="2" ItemsSource="{Binding RowsView}"
                 ItemTemplate="{StaticResource RowTemplate}" ItemContainerStyle="{StaticResource RowContainer}"
                 Background="Transparent" BorderThickness="0" Padding="0"
                 Foreground="{DynamicResource TextPrimaryBrush}"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 VirtualizingPanel.IsVirtualizing="True"
                 VirtualizingPanel.IsVirtualizingWhenGrouping="True"
                 VirtualizingPanel.VirtualizationMode="Standard"
                 VirtualizingPanel.ScrollUnit="Pixel"
                 KeyDown="OnListKeyDown"
                 Visibility="{Binding Rows.Count, Converter={StaticResource CountToVisibility}}">
            <ListBox.GroupStyle>
                <GroupStyle HidesIfEmpty="True">
                    <GroupStyle.HeaderTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Name}" FontSize="11" FontWeight="SemiBold" Margin="12,10,8,4"
                                       Foreground="{DynamicResource TextMutedBrush}"/>
                        </DataTemplate>
                    </GroupStyle.HeaderTemplate>
                </GroupStyle>
            </ListBox.GroupStyle>
        </ListBox>
    </Grid>
</UserControl>
