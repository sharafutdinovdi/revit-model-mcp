<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Activity pane design tokens. ActivityPaneView copies one variant into its own resources and
         swaps it when Revit's UI theme changes (Revit 2024+; Revit 2022-2023 always use Light). -->
    <ResourceDictionary x:Key="Dark">
        <SolidColorBrush x:Key="SurfaceBrush" Color="#2B313B"/>
        <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="#343B47"/>
        <SolidColorBrush x:Key="HairlineBrush" Color="#3E4654"/>
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#E7EAEF"/>
        <SolidColorBrush x:Key="TextMutedBrush" Color="#9AA3AF"/>
        <SolidColorBrush x:Key="RunningBrush" Color="#4C9AFF"/>
        <SolidColorBrush x:Key="DoneBrush" Color="#3FB27F"/>
        <SolidColorBrush x:Key="FailedBrush" Color="#E5534B"/>
        <SolidColorBrush x:Key="CreatedBrush" Color="#3FB27F"/>
        <SolidColorBrush x:Key="DeletedBrush" Color="#E5534B"/>
        <SolidColorBrush x:Key="ReadOnlyBrush" Color="#E3B341"/>
    </ResourceDictionary>

    <ResourceDictionary x:Key="Light">
        <SolidColorBrush x:Key="SurfaceBrush" Color="#F7F8FA"/>
        <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="HairlineBrush" Color="#E2E5EA"/>
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#1F2328"/>
        <SolidColorBrush x:Key="TextMutedBrush" Color="#687180"/>
        <SolidColorBrush x:Key="RunningBrush" Color="#2F7FE8"/>
        <SolidColorBrush x:Key="DoneBrush" Color="#23945F"/>
        <SolidColorBrush x:Key="FailedBrush" Color="#CF3A32"/>
        <SolidColorBrush x:Key="CreatedBrush" Color="#23945F"/>
        <SolidColorBrush x:Key="DeletedBrush" Color="#CF3A32"/>
        <SolidColorBrush x:Key="ReadOnlyBrush" Color="#9A6700"/>
    </ResourceDictionary>
</ResourceDictionary>
