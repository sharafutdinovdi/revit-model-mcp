<Project Sdk="Nice3point.Revit.Sdk/6.2.3">

  <PropertyGroup>
    <AssemblyName>RevitModelMcp</AssemblyName>
    <RootNamespace>RevitModelMcp</RootNamespace>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <ManagedInstall Condition="'$(ManagedInstall)' == ''">false</ManagedInstall>
    <DeployAddin>true</DeployAddin>
    <PublishAddin>true</PublishAddin>
    <LaunchRevit>true</LaunchRevit>
    <IsRepackable Condition="$([MSBuild]::IsOSPlatform('Windows'))">true</IsRepackable>
    <RepackBinariesExcludes>System*.dll;Microsoft.CodeAnalysis*.dll</RepackBinariesExcludes>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <Authors>Dinar Sharafutdinov</Authors>
    <Company>Dinar Sharafutdinov</Company>
    <Configurations>Debug.R22;Debug.R23;Debug.R24;Debug.R25;Debug.R26;Debug.R27</Configurations>
    <Configurations>$(Configurations);Release.R22;Release.R23;Release.R24;Release.R25;Release.R26;Release.R27</Configurations>
  </PropertyGroup>

  <!-- Builds without an explicit Version use the repository version, never the SDK default 1.0.0. -->
  <PropertyGroup>
    <RepositoryVersion>$([System.Text.RegularExpressions.Regex]::Match($([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)../../server/pyproject.toml')), '(?m)^version = \x22(\d+\.\d+\.\d+)\x22').Groups[1].Value)</RepositoryVersion>
    <VersionPrefix Condition="'$(RepositoryVersion)' != ''">$(RepositoryVersion)</VersionPrefix>
  </PropertyGroup>

  <PropertyGroup Condition="'$(RevitVersion)' == '2022'">
    <MinimumRevitApiPackageVersion>2022.1.1</MinimumRevitApiPackageVersion>
    <MinimumRevitApiAssemblyVersion>22.0.0.0</MinimumRevitApiAssemblyVersion>
  </PropertyGroup>
  <PropertyGroup Condition="'$(RevitVersion)' == '2023'">
    <MinimumRevitApiPackageVersion>2023.0.1</MinimumRevitApiPackageVersion>
    <MinimumRevitApiAssemblyVersion>23.0.0.0</MinimumRevitApiAssemblyVersion>
  </PropertyGroup>
  <PropertyGroup Condition="'$(RevitVersion)' == '2024'">
    <MinimumRevitApiPackageVersion>2024.0.0</MinimumRevitApiPackageVersion>
    <MinimumRevitApiAssemblyVersion>24.0.0.0</MinimumRevitApiAssemblyVersion>
  </PropertyGroup>
  <PropertyGroup Condition="'$(RevitVersion)' == '2025'">
    <MinimumRevitApiPackageVersion>2025.0.2</MinimumRevitApiPackageVersion>
    <MinimumRevitApiAssemblyVersion>25.0.0.0</MinimumRevitApiAssemblyVersion>
  </PropertyGroup>
  <PropertyGroup Condition="'$(RevitVersion)' == '2026'">
    <MinimumRevitApiPackageVersion>2026.0.4</MinimumRevitApiPackageVersion>
    <MinimumRevitApiAssemblyVersion>26.0.4.0</MinimumRevitApiAssemblyVersion>
  </PropertyGroup>
  <PropertyGroup Condition="'$(RevitVersion)' == '2027'">
    <MinimumRevitApiPackageVersion>2027.0.0</MinimumRevitApiPackageVersion>
    <MinimumRevitApiAssemblyVersion>27.0.0.0</MinimumRevitApiAssemblyVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Nice3point.Revit.Toolkit" Version="$(RevitVersion).*"/>
    <PackageReference Include="Nice3point.Revit.Extensions" Version="$(RevitVersion).*"/>
    <PackageReference Include="Nice3point.Revit.Api.RevitAPI" Version="[$(MinimumRevitApiPackageVersion)]"/>
    <PackageReference Include="Nice3point.Revit.Api.RevitAPIUI" Version="[$(MinimumRevitApiPackageVersion)]"/>
    <PackageReference Include="ILRepack" Version="2.0.46" PrivateAssets="all"/>
    <PackageReference Include="JetBrains.Annotations" Version="2026.2.0" PrivateAssets="all"/>
    <PackageReference Include="Polyfill" Version="11.0.1" PrivateAssets="all"/>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.11.0"/>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" Condition="'$(TargetFramework)' == 'net48'"/>
  </ItemGroup>

  <ItemGroup>
    <AssemblyMetadata Include="ManagedInstall" Value="$(ManagedInstall)"/>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\RevitModelMcp.Core\RevitModelMcp.Core.csproj"/>
    <ProjectReference Include="..\RevitModelMcp.Updater\RevitModelMcp.Updater.csproj"
                      ReferenceOutputAssembly="false"
                      SkipGetTargetFrameworkProperties="true"
                      SetTargetFramework="TargetFramework=net48"/>
    <ProjectReference Include="..\RevitModelMcp.BatchSupervisor\RevitModelMcp.BatchSupervisor.csproj"
                      ReferenceOutputAssembly="false"
                      SkipGetTargetFrameworkProperties="true"
                      SetTargetFramework="TargetFramework=net48"/>
  </ItemGroup>

  <Target Name="CopyUpdater" AfterTargets="Build">
    <Copy SourceFiles="$(MSBuildProjectDirectory)/../RevitModelMcp.Updater/bin/$(Configuration)/net48/RevitModelMcp.Updater.exe"
          DestinationFolder="$(TargetDir)"/>
  </Target>

  <Target Name="CopyBatchSupervisor" AfterTargets="Build">
    <Copy SourceFiles="$(MSBuildProjectDirectory)/../RevitModelMcp.BatchSupervisor/bin/$(Configuration)/net48/RevitModelMcp.BatchSupervisor.exe"
          DestinationFolder="$(TargetDir)"/>
    <Copy SourceFiles="$(MSBuildProjectDirectory)/../RevitModelMcp.BatchSupervisor/bin/$(Configuration)/net48/RevitModelMcp.Core.dll"
          DestinationFolder="$(TargetDir)"/>
  </Target>

  <Target Name="RemoveNetRuntimeDependencies"
          AfterTargets="CopyFilesToOutputDirectory"
          BeforeTargets="PublishAddin"
          Condition="'$(TargetFramework)' == 'net8.0-windows' Or '$(TargetFramework)' == 'net10.0-windows'">
    <Delete Files="$(TargetDir)System.Collections.Immutable.dll;$(TargetDir)System.Reflection.Metadata.dll;$(TargetDir)System.Memory.dll"/>
  </Target>

  <ItemGroup>
    <Resource Include="Resources\Icons\*.png"/>
  </ItemGroup>

  <Target Name="PinMergedRevitApiReferences"
          AfterTargets="RepackAddinFiles"
          Condition="'$(IsRepackable)' == 'true'">
    <Error Condition="'$(MinimumRevitApiAssemblyVersion)' == ''"
           Text="No minimum Revit API assembly version is configured for Revit $(RevitVersion)."/>
    <Exec Command="dotnet run --project &quot;$(MSBuildProjectDirectory)/../../build/RevitApiReferencePin/RevitApiReferencePin.csproj&quot; --configuration Release --no-restore -- rewrite &quot;$(TargetPath)&quot; $(MinimumRevitApiAssemblyVersion)"/>
  </Target>

</Project>
