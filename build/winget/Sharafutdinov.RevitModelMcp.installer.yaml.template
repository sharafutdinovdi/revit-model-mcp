  - Architecture: x64
    Scope: machine
    InstallerUrl: '{{MULTI_USER_URL}}'
    InstallerSha256: '{{MULTI_USER_SHA256}}'
    ProductCode: '{{MULTI_USER_PRODUCT_CODE}}'
ManifestType: installer
ManifestVersion: 1.12.0
