<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <Nullable>enable</Nullable>
        <LangVersion>latest</LangVersion>
        <ImplicitUsings>true</ImplicitUsings>
        <TargetFramework>net10.0-windows</TargetFramework>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="WixSharp.Core" Version="2.14.2"/>
        <PackageReference Include="WixSharp.Msi.Core" Version="2.14.2"/>
    </ItemGroup>

    <Target Name="BuildConnectSetup" BeforeTargets="Build">
        <MSBuild Projects="../../src/RevitModelMcp.ConnectSetup/RevitModelMcp.ConnectSetup.csproj"
                 Targets="Restore;Build" Properties="Configuration=Release" />
        <ItemGroup>
            <ConnectSetupFiles Include="../../src/RevitModelMcp.ConnectSetup/bin/Release/net48/*.*" />
        </ItemGroup>
        <Copy SourceFiles="@(ConnectSetupFiles)" DestinationFolder="$(OutputPath)connect" />
    </Target>

</Project>
